#!/usr/bin/env bash
set -euo pipefail

pkill -x fuzzel && exit 0

SWAY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sway"
FUZZEL_CFG="$SWAY_DIR/fuzzel/fuzzel.ini"
SCRIPTS="$SWAY_DIR/scripts"

choice=$(cat <<'EOF' | fuzzel --config="$FUZZEL_CFG" --dmenu --prompt="Settings > " --width=36 || true
Wi-Fi
Bluetooth
Audio
Power Profile
Clipboard
Screenshot
Power / Session
Network Editor (GUI)
Volume Mixer (GUI)
EOF
)
[[ -z "$choice" ]] && exit 0

case "$choice" in
    "Wi-Fi")                exec "$SCRIPTS/menu-wifi" ;;
    "Bluetooth")            exec "$SCRIPTS/menu-bluetooth" ;;
    "Audio")                exec "$SCRIPTS/menu-audio" ;;
    "Power Profile")        exec "$SCRIPTS/menu-power" profile ;;
    "Clipboard")            exec "$SCRIPTS/menu-clipboard" ;;
    "Screenshot")           exec "$SCRIPTS/screenshot" menu ;;
    "Power / Session")      exec "$SCRIPTS/menu-power" ;;
    "Network Editor (GUI)") exec nm-connection-editor ;;
    "Volume Mixer (GUI)")   exec pavucontrol ;;
esac
