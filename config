### Variables
set $mod Mod4
set $alt Mod1
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $lock_timeout 5400 # 1.5hr
set $screen_off_timeout 5400 # 1.5hr

exec_always pkill kanshi; exec kanshi

# Switch mode and recolor the focused window (purple while in "super" mode)
set $switch_mode_default client.focused #4c7899 #285577 #ffffff #2e9fff #285577, mode "default"
set $switch_mode_super client.focused #6a3d9a #4b2a6e #ffffff #a77bd6 #6a3d9a, mode "super"

# special cases
for_window [class="Godot"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol|pavucontrol|nm-connection-editor"] floating enable
exec dbus-update-activation-environment --systemd DISPLAY I3SOCK SWAYSOCK WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

### Desktop environment services
exec_always pkill mako; exec mako -c ~/.config/sway/mako/config
exec sh -c 'for p in /usr/lib/polkit-kde-authentication-agent-1 /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1; do [ -x "$p" ] && exec "$p"; done'
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec swayidle -w \
    timeout $lock_timeout 'swaylock -f -C ~/.config/sway/swaylock/config' \
    timeout $screen_off_timeout 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -C ~/.config/sway/swaylock/config'

### Input configuration
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    accel_profile "flat"
    pointer_accel 0.5
}

mouse_warping container
seat seat0 hide_cursor 3000
seat seat0 hide_cursor when-typing enabled

### Key bindings
    # Start a terminal
    bindsym $mod+T exec $term
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+q kill

    # Launcher & menus:
    set $launcher fuzzel --config ~/.config/sway/fuzzel/fuzzel.ini || pkill fuzzel
    bindsym $mod+X exec $launcher
    bindsym $mod+c exec ~/.config/sway/scripts/menu-settings
    bindsym $mod+v exec ~/.config/sway/scripts/menu-clipboard
    bindsym $mod+Shift+p exec ~/.config/sway/scripts/menu-power

    # Drag floating windows by holding down $mod and left mouse button.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right

    bindsym $mod+N focus next
    bindsym $mod+Shift+N focus prev
    bindsym $mod+P focus prev

#
# Workspaces:
#
    set $ws11 "11:1.1"
    set $ws12 "12:1.2"
    set $ws13 "13:1.3"
    set $ws14 "14:1.4"
    set $ws15 "15:1.5"
    set $ws16 "16:1.6"
    set $ws17 "17:1.7"
    set $ws18 "18:1.8"
    set $ws19 "19:1.9"

    set $ws21 "21:2.1"
    set $ws22 "22:2.2"
    set $ws23 "23:2.3"
    set $ws24 "24:2.4"
    set $ws25 "25:2.5"
    set $ws26 "26:2.6"
    set $ws27 "27:2.7"
    set $ws28 "28:2.8"
    set $ws29 "29:2.9"

    set $home_right "GIGA-BYTE TECHNOLOGY CO., LTD. GS27QA 24242B001022"
    set $home_left  "BNQ BenQ EW3270U 95P00593019"
    set $work_right "ASUSTek COMPUTER INC ASUS VA24E NCLMTF043025"
    set $work_left  "ASUSTek COMPUTER INC ASUS VA24E NCLMTF043000"

    workspace $ws11 output $home_right $work_right
    workspace $ws12 output $home_right $work_right
    workspace $ws13 output $home_right $work_right
    workspace $ws14 output $home_right $work_right
    workspace $ws15 output $home_right $work_right
    workspace $ws16 output $home_right $work_right
    workspace $ws17 output $home_right $work_right
    workspace $ws18 output $home_right $work_right
    workspace $ws19 output $home_right $work_right

    workspace $ws21 output $home_left $work_left
    workspace $ws22 output $home_left $work_left
    workspace $ws23 output $home_left $work_left
    workspace $ws24 output $home_left $work_left
    workspace $ws25 output $home_left $work_left
    workspace $ws26 output $home_left $work_left
    workspace $ws27 output $home_left $work_left
    workspace $ws28 output $home_left $work_left
    workspace $ws29 output $home_left $work_left

    # switch to workspace
    set $ws-cycle exec ~/.config/sway/scripts/ws-cycle.pl
    bindsym $mod+1 $ws-cycle $ws11
    bindsym $mod+2 $ws-cycle $ws12
    bindsym $mod+3 $ws-cycle $ws13
    bindsym $mod+4 $ws-cycle $ws14
    bindsym $mod+5 $ws-cycle $ws15
    bindsym $mod+6 $ws-cycle $ws16
    bindsym $mod+7 $ws-cycle $ws17
    bindsym $mod+8 $ws-cycle $ws18
    bindsym $mod+9 $ws-cycle $ws19
    bindsym $mod+Shift+1 $ws-cycle $ws21
    bindsym $mod+Shift+2 $ws-cycle $ws22
    bindsym $mod+Shift+3 $ws-cycle $ws23
    bindsym $mod+Shift+4 $ws-cycle $ws24
    bindsym $mod+Shift+5 $ws-cycle $ws25
    bindsym $mod+Shift+6 $ws-cycle $ws26
    bindsym $mod+Shift+7 $ws-cycle $ws27
    bindsym $mod+Shift+8 $ws-cycle $ws28
    bindsym $mod+Shift+9 $ws-cycle $ws29

    bindsym $mod+Tab workspace next
    bindsym $mod+Shift+Tab workspace prev

#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splitt

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split
    bindsym $mod+d layout default

    # Make the current focus fullscreen
    bindsym $mod+F fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent

#
# Scratchpad:
#
    bindsym $mod+Shift+grave exec ~/.config/sway/scripts/scratch-workspace
    bindsym $mod+grave [con_mark="^_scratch_workspace$"] scratchpad show

### Super mode
# enter
bindsym --no-repeat --release Super_L $switch_mode_super, exec pkill fuzzel
mode "super" {
    # exit
    bindsym --no-repeat --release Super_L $switch_mode_default
    bindsym Return $switch_mode_default
    bindsym Escape $switch_mode_default

    # move
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right

    # move workspace
    bindsym $mod+1 move container to workspace $ws11, $switch_mode_default
    bindsym $mod+2 move container to workspace $ws12, $switch_mode_default
    bindsym $mod+3 move container to workspace $ws13, $switch_mode_default
    bindsym $mod+4 move container to workspace $ws14, $switch_mode_default
    bindsym $mod+5 move container to workspace $ws15, $switch_mode_default
    bindsym $mod+6 move container to workspace $ws16, $switch_mode_default
    bindsym $mod+7 move container to workspace $ws17, $switch_mode_default
    bindsym $mod+8 move container to workspace $ws18, $switch_mode_default
    bindsym $mod+9 move container to workspace $ws19, $switch_mode_default

    bindsym $mod+Shift+1 move container to workspace $ws21, $switch_mode_default
    bindsym $mod+Shift+2 move container to workspace $ws22, $switch_mode_default
    bindsym $mod+Shift+3 move container to workspace $ws23, $switch_mode_default
    bindsym $mod+Shift+4 move container to workspace $ws24, $switch_mode_default
    bindsym $mod+Shift+5 move container to workspace $ws25, $switch_mode_default
    bindsym $mod+Shift+6 move container to workspace $ws26, $switch_mode_default
    bindsym $mod+Shift+7 move container to workspace $ws27, $switch_mode_default
    bindsym $mod+Shift+8 move container to workspace $ws28, $switch_mode_default
    bindsym $mod+Shift+9 move container to workspace $ws29, $switch_mode_default

    # resize
    set $resize exec ~/.config/sway/scripts/resize
    bindsym $left $resize shrink width 32px
    bindsym $right $resize grow width 32px
    bindsym $down $resize shrink height 32px
    bindsym $up $resize grow height 32px

    bindsym Shift+$left $resize shrink width 128px
    bindsym Shift+$right $resize grow width 128px
    bindsym Shift+$down $resize shrink height 128px
    bindsym Shift+$up $resize grow height 128px
}

### Utilities:
    # Special keys to adjust volume via WirePlumber (capped at 100%)
    bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

    # Special keys to control media via playerctl
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

    # Special keys to take screenshots (saved to ~/Pictures/Screenshots and copied to clipboard)
    bindsym Print exec ~/.config/sway/scripts/screenshot region
    bindsym $mod+Shift+s exec ~/.config/sway/scripts/screenshot region
    bindsym Shift+Print exec ~/.config/sway/scripts/screenshot screen

### Status Bar:
exec_always exec ~/.config/sway/scripts/bar

# Set current workspace to 1.1
exec_always $ws-cycle $ws11

include /etc/sway/config.d/*
